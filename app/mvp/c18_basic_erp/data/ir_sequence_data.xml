<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        no_gap ir.sequence per jenis jurnal (c18_basic_erp, tier Basic).
        Format: KODE-yyyy-mm-xxx (yyyy/mm cuma tampilan tanggal berjalan; xxx = 3 digit,
        counter berlanjut terus TANPA reset per bulan/tahun - dikonfirmasi 2026-08-26,
        makanya use_date_range TIDAK diset True di sini, counter global per jenis jurnal).
        Kode prefix maks 4 huruf (dikonfirmasi 2026-08-26). Detail per jenis:
        erd/mvp/06-accounting-business.md.
    -->

    <!-- Jurnal Umum & Tutup Buku (poin A, C) -->
    <record id="seq_c18_basic_erp_ju" model="ir.sequence">
        <field name="name">Jurnal Umum</field>
        <field name="code">c18.account.journal.ju</field>
        <field name="prefix">JU-%(year)s-%(month)s-</field>
        <field name="padding">3</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
