<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="c18_basic_erp.TrialBalanceYearlyReport">
        <div class="o_c18_trial_balance_yearly p-4">
            <h3 class="mb-3">Trial Balance - 12 Bulan (Kertas Kerja)</h3>

            <div class="d-flex align-items-end gap-3 mb-3 o_c18_report_filters">
                <div>
                    <label class="form-label mb-0">Tahun</label>
                    <input type="number" class="form-control" style="width: 100px;"
                           t-att-value="state.year" t-on-change="onYearChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Cost Center</label>
                    <select class="form-select" t-on-change="onCostCenterChange">
                        <option value="">Semua Cost Center</option>
                        <t t-foreach="costCenterOptions" t-as="opt" t-key="opt.value">
                            <option t-att-value="opt.value" t-esc="opt.label"/>
                        </t>
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="c18_tby_hide_zero"
                           t-att-checked="state.hideZero" t-on-change="onHideZeroChange"/>
                    <label class="form-check-label" for="c18_tby_hide_zero">Sembunyikan saldo nol (semua bulan)</label>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted">Memuat...</div>

            <div t-if="!state.loading and state.data" class="o_c18_yearly_table_wrap" style="overflow-x: auto;">
                <table class="table table-sm table-bordered o_c18_report_table o_c18_yearly_table">
                    <thead>
                        <tr>
                            <th class="o_c18_freeze_col" style="left: 0;">Kode</th>
                            <th class="o_c18_freeze_col" style="left: 60px;">Nama Akun</th>
                            <t t-foreach="monthLabels" t-as="m" t-key="m">
                                <th class="text-end" colspan="2" t-esc="m"/>
                            </t>
                        </tr>
                        <tr>
                            <th class="o_c18_freeze_col" style="left: 0;"></th>
                            <th class="o_c18_freeze_col" style="left: 60px;"></th>
                            <t t-foreach="monthLabels" t-as="m" t-key="m + '_dk'">
                                <th class="text-end">D</th>
                                <th class="text-end">K</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.rows" t-as="row" t-key="row.account_id">
                            <td class="o_c18_freeze_col" style="left: 0;" t-esc="row.code"/>
                            <td class="o_c18_freeze_col" style="left: 60px;" t-esc="row.name"/>
                            <t t-foreach="row.months" t-as="month" t-key="month_index">
                                <td class="text-end" t-esc="month.debit_fmt"/>
                                <td class="text-end" t-esc="month.credit_fmt"/>
                            </t>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td class="o_c18_freeze_col" style="left: 0;" colspan="2">Total</td>
                            <t t-foreach="state.data.month_totals" t-as="total" t-key="total_index">
                                <td class="text-end" t-esc="total.debit_fmt"/>
                                <td class="text-end" t-esc="total.credit_fmt"/>
                            </t>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>
</templates>
