<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="c18_basic_erp.EquityChangesReport">
        <div class="o_c18_equity_changes p-4">
            <h3 class="mb-3">Laporan Perubahan Ekuitas</h3>

            <div class="d-flex align-items-end gap-3 mb-3 o_c18_report_filters">
                <div>
                    <label class="form-label mb-0">Dari Tanggal</label>
                    <input type="date" class="form-control" t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Sampai Tanggal</label>
                    <input type="date" class="form-control" t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted">Memuat...</div>

            <t t-if="!state.loading and state.data">
                <table class="table table-sm table-bordered o_c18_report_table">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="text-end">Modal</th>
                            <th class="text-end">Laba Ditahan</th>
                            <th class="text-end">Dividen</th>
                            <th class="text-end">Total Ekuitas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.rows" t-as="row" t-key="row.label">
                            <td t-esc="row.label"/>
                            <td class="text-end" t-esc="row.modal_fmt"/>
                            <td class="text-end" t-esc="row.laba_ditahan_fmt"/>
                            <td class="text-end" t-esc="row.dividen_fmt"/>
                            <td class="text-end" t-esc="row.total_fmt"/>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td t-esc="state.data.closing_row.label"/>
                            <td class="text-end" t-esc="state.data.closing_row.modal_fmt"/>
                            <td class="text-end" t-esc="state.data.closing_row.laba_ditahan_fmt"/>
                            <td class="text-end" t-esc="state.data.closing_row.dividen_fmt"/>
                            <td class="text-end" t-esc="state.data.closing_row.total_fmt"/>
                        </tr>
                    </tfoot>
                </table>
            </t>
        </div>
    </t>
</templates>
