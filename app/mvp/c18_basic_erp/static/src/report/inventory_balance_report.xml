<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="c18_basic_erp.InventoryBalanceReport">
        <div class="o_c18_inventory_balance p-4">
            <h3 class="mb-3">Saldo Persediaan</h3>

            <div t-if="state.loading" class="text-muted">Memuat...</div>

            <t t-if="!state.loading and state.data">
                <p class="text-muted">Metode Costing: <span t-esc="state.data.costing_method"/></p>
                <table class="table table-sm table-bordered o_c18_report_table" style="max-width: 500px;">
                    <thead>
                        <tr>
                            <th>Produk</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Nilai</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.rows" t-as="row" t-key="row.code">
                            <td><span t-esc="row.code"/> <span t-esc="row.name"/></td>
                            <td class="text-end" t-esc="row.qty_fmt"/>
                            <td class="text-end" t-esc="row.value_fmt"/>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Total</td>
                            <td class="text-end" t-esc="state.data.total_value_fmt"/>
                        </tr>
                    </tfoot>
                </table>
                <p class="text-muted fst-italic">Total ini seharusnya cocok dgn saldo akun "1-1300 Persediaan Barang Dagang" di Trial Balance/Neraca.</p>
            </t>
        </div>
    </t>
</templates>
