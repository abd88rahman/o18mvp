<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="c18_basic_erp.GeneralLedgerReport">
        <div class="o_c18_general_ledger p-4">
            <h3 class="mb-3">Buku Besar (General Ledger)</h3>

            <div class="d-flex align-items-end gap-3 mb-3 flex-wrap o_c18_report_filters">
                <div>
                    <label class="form-label mb-0">Akun</label>
                    <select class="form-select" t-on-change="onAccountChange">
                        <t t-foreach="accountOptions" t-as="opt" t-key="opt.value">
                            <option t-att-value="opt.value" t-esc="opt.label"
                                    t-att-selected="opt.value === state.data.account_id"/>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0">Dari Tanggal</label>
                    <input type="date" class="form-control" t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Sampai Tanggal</label>
                    <input type="date" class="form-control" t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Partner</label>
                    <select class="form-select" t-on-change="onPartnerChange">
                        <option value="">Semua Partner</option>
                        <t t-foreach="partnerOptions" t-as="opt" t-key="opt.value">
                            <option t-att-value="opt.value" t-esc="opt.label"/>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label mb-0">Cost Center</label>
                    <select class="form-select" t-on-change="onCostCenterChange">
                        <option value="">Semua Cost Center</option>
                        <t t-foreach="costCenterOptions" t-as="opt" t-key="opt.value">
                            <option t-att-value="opt.value" t-esc="opt.label"/>
                        </t>
                    </select>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted">Memuat...</div>

            <t t-if="!state.loading and state.data">
                <h5 t-esc="state.data.account_label"/>

                <table class="table table-sm table-bordered o_c18_report_table">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>No. Dokumen</th>
                            <th>Keterangan</th>
                            <th>Partner</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Kredit</th>
                            <th class="text-end">Saldo Berjalan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="fst-italic">Saldo Awal</td>
                            <td class="text-end fst-italic" t-esc="state.data.opening_balance_fmt"/>
                        </tr>
                        <tr t-foreach="state.data.rows" t-as="row" t-key="row.move_id + '_' + row_index">
                            <td t-esc="row.date"/>
                            <td>
                                <a href="#" t-on-click.prevent="() => this.openDocument(row)" t-esc="row.move_name"/>
                            </td>
                            <td t-esc="row.description"/>
                            <td t-esc="row.partner"/>
                            <td class="text-end" t-esc="row.debit_fmt"/>
                            <td class="text-end" t-esc="row.credit_fmt"/>
                            <td class="text-end" t-esc="row.running_balance_fmt"/>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="4">Total Periode</td>
                            <td class="text-end" t-esc="state.data.totals.debit_fmt"/>
                            <td class="text-end" t-esc="state.data.totals.credit_fmt"/>
                            <td class="text-end" t-esc="state.data.totals.closing_balance_fmt"/>
                        </tr>
                    </tfoot>
                </table>
            </t>
        </div>
    </t>
</templates>
