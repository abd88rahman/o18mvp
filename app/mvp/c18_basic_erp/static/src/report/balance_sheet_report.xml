<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="c18_basic_erp.BalanceSheetReport">
        <div class="o_c18_balance_sheet p-4">
            <h3 class="mb-3">Neraca (Balance Sheet)</h3>

            <div class="d-flex align-items-end gap-3 mb-3 o_c18_report_filters">
                <div>
                    <label class="form-label mb-0">Per Tanggal</label>
                    <input type="date" class="form-control" t-att-value="state.dateTo" t-on-change="onDateChange"/>
                </div>
                <div>
                    <label class="form-label mb-0">Cost Center</label>
                    <select class="form-select" t-on-change="onCostCenterChange">
                        <option value="">Semua Cost Center</option>
                        <t t-foreach="costCenterOptions" t-as="opt" t-key="opt.value">
                            <option t-att-value="opt.value" t-esc="opt.label"/>
                        </t>
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="c18_bs_hide_zero"
                           t-att-checked="state.hideZero" t-on-change="onHideZeroChange"/>
                    <label class="form-check-label" for="c18_bs_hide_zero">Sembunyikan saldo nol</label>
                </div>
            </div>

            <div t-if="state.loading" class="text-muted">Memuat...</div>

            <t t-if="!state.loading and state.data">
                <div t-if="state.data.mismatch" class="alert alert-danger">
                    Total Aset tidak sama dengan Total Kewajiban + Ekuitas - ada bug di sistem, laporkan segera.
                </div>

                <div class="row">
                    <div class="col-6">
                        <h5>ASET</h5>
                        <t t-foreach="['aset_lancar', 'aset_tidak_lancar']" t-as="key" t-key="key">
                            <table class="table table-sm o_c18_report_table">
                                <thead><tr><th colspan="2" t-esc="state.data.sections[key].label"/></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.sections[key].rows" t-as="row" t-key="row.code + row.name">
                                        <td><span t-esc="row.code"/> <span t-esc="row.name"/></td>
                                        <td class="text-end" t-esc="row.amount_fmt"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td>Total <t t-esc="state.data.sections[key].label"/></td>
                                        <td class="text-end" t-esc="state.data.sections[key].subtotal_fmt"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <div class="fw-bold d-flex justify-content-between border-top pt-2">
                            <span>TOTAL ASET</span>
                            <span t-esc="state.data.total_aset_fmt"/>
                        </div>
                    </div>

                    <div class="col-6">
                        <h5>KEWAJIBAN &amp; EKUITAS</h5>
                        <t t-foreach="['kewajiban_lancar', 'kewajiban_panjang', 'ekuitas']" t-as="key" t-key="key">
                            <table class="table table-sm o_c18_report_table">
                                <thead><tr><th colspan="2" t-esc="state.data.sections[key].label"/></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.sections[key].rows" t-as="row" t-key="row.code + row.name">
                                        <td><span t-esc="row.code"/> <span t-esc="row.name"/></td>
                                        <td class="text-end" t-esc="row.amount_fmt"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td>Total <t t-esc="state.data.sections[key].label"/></td>
                                        <td class="text-end" t-esc="state.data.sections[key].subtotal_fmt"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <div class="fw-bold d-flex justify-content-between border-top pt-2">
                            <span>TOTAL KEWAJIBAN + EKUITAS</span>
                            <span t-esc="state.data.total_kewajiban_ekuitas_fmt"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
