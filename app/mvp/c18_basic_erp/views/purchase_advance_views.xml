<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_purchase_advance_list" model="ir.ui.view">
        <field name="name">c18.purchase.advance.list</field>
        <field name="model">c18.purchase.advance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="po_ref_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_purchase_advance_form" model="ir.ui.view">
        <field name="name">c18.purchase.advance.form</field>
        <field name="model">c18.purchase.advance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="po_ref_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                            <field name="note" readonly="state != 'draft'"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_purchase_advance" model="ir.actions.act_window">
        <field name="name">Purchase Advance</field>
        <field name="res_model">c18.purchase.advance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
