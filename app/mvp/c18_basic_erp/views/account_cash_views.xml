<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_basic_erp_cash_list" model="ir.ui.view">
        <field name="name">c18.account.cash.list</field>
        <field name="model">c18.account.cash</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_basic_erp_cash_form" model="ir.ui.view">
        <field name="name">c18.account.cash.form</field>
        <field name="model">c18.account.cash</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="journal_id" readonly="state != 'draft'" invisible="1"/>
                            <field name="is_transfer" invisible="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="account_id_dest" readonly="state != 'draft'" invisible="not is_transfer"
                                   domain="[('account_type', '=', 'cash_bank'), ('id', '!=', account_id)]"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'" invisible="is_transfer"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'" invisible="not is_transfer"/>
                            <field name="note" readonly="state != 'draft'"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'" invisible="is_transfer">
                        <list editable="bottom">
                            <field name="account_id" domain="[('account_type', '!=', 'cash_bank')]"/>
                            <field name="name"/>
                            <field name="amount"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_basic_erp_cash_in" model="ir.actions.act_window">
        <field name="name">Cash In</field>
        <field name="res_model">c18.account.cash</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('journal_id.code', '=', 'KM')]"/>
        <field name="context" eval="{'default_journal_id': ref('journal_km')}"/>
    </record>

    <record id="action_c18_basic_erp_cash_out" model="ir.actions.act_window">
        <field name="name">Cash Out</field>
        <field name="res_model">c18.account.cash</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('journal_id.code', '=', 'KK')]"/>
        <field name="context" eval="{'default_journal_id': ref('journal_kk')}"/>
    </record>

    <record id="action_c18_basic_erp_cash_transfer" model="ir.actions.act_window">
        <field name="name">Cash/Bank Transfer</field>
        <field name="res_model">c18.account.cash</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('journal_id.code', '=', 'TRF')]"/>
        <field name="context" eval="{'default_journal_id': ref('journal_trf')}"/>
    </record>
</odoo>
