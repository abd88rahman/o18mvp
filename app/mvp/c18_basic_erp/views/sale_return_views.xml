<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_sale_return_list" model="ir.ui.view">
        <field name="name">c18.sale.return.list</field>
        <field name="model">c18.sale.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount_revenue_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_sale_return_form" model="ir.ui.view">
        <field name="name">c18.sale.return.form</field>
        <field name="model">c18.sale.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="delivery_ref_id" readonly="state != 'draft'"/>
                            <field name="invoice_id" readonly="state != 'draft'"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="unit_cost_hint"/>
                            <field name="cost_amount" readonly="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_revenue_total"/>
                        <field name="amount_cost_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_sale_return" model="ir.actions.act_window">
        <field name="name">Retur Barang Customer</field>
        <field name="res_model">c18.sale.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
