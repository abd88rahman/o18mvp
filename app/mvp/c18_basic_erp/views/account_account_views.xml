<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_basic_erp_account_list" model="ir.ui.view">
        <field name="name">c18.account.account.list</field>
        <field name="model">c18.account.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
            </list>
        </field>
    </record>

    <record id="view_c18_basic_erp_account_form" model="ir.ui.view">
        <field name="name">c18.account.account.form</field>
        <field name="model">c18.account.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="account_type"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_basic_erp_account" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">c18.account.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
