<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_basic_erp_closing_list" model="ir.ui.view">
        <field name="name">c18.account.closing.list</field>
        <field name="model">c18.account.closing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="closing_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_basic_erp_closing_form" model="ir.ui.view">
        <field name="name">c18.account.closing.form</field>
        <field name="model">c18.account.closing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" type="object" string="Proses Tutup Buku"
                            class="oe_highlight" invisible="state != 'draft'"
                            confirm="Tutup Buku akan menolkan seluruh akun Pendapatan/Beban tahun ini dan memindahkan selisihnya ke Laba Ditahan. Tindakan ini mengunci periode - lanjutkan?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="fiscal_year" readonly="state != 'draft'"/>
                        <field name="closing_date" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_basic_erp_closing" model="ir.actions.act_window">
        <field name="name">Tutup Buku</field>
        <field name="res_model">c18.account.closing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
