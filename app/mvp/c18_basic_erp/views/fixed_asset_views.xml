<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_fixed_asset_entry_list" model="ir.ui.view">
        <field name="name">c18.fixed.asset.entry.list</field>
        <field name="model">c18.fixed.asset.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="transaction_type"/>
                <field name="asset_tag_id"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_fixed_asset_entry_form" model="ir.ui.view">
        <field name="name">c18.fixed.asset.entry.form</field>
        <field name="model">c18.fixed.asset.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="transaction_type" readonly="state != 'draft'"/>
                            <field name="asset_tag_id" readonly="state != 'draft'"
                                   required="transaction_type == 'pengakuan'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="debit_account_id" readonly="state != 'draft'"
                                   domain="[('account_type', '=', 'fixed_asset')] if transaction_type == 'pengakuan' else []"/>
                            <field name="credit_account_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="exchange_rate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="partner_id" readonly="state != 'draft'"/>
                        <field name="cost_center_id" readonly="state != 'draft'"/>
                        <field name="note" readonly="state != 'draft'"/>
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_fixed_asset_entry" model="ir.actions.act_window">
        <field name="name">Fixed Asset</field>
        <field name="res_model">c18.fixed.asset.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_c18_fixed_asset_tag_list" model="ir.ui.view">
        <field name="name">c18.fixed.asset.tag.list</field>
        <field name="model">c18.fixed.asset.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_c18_fixed_asset_tag_form" model="ir.ui.view">
        <field name="name">c18.fixed.asset.tag.form</field>
        <field name="model">c18.fixed.asset.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_fixed_asset_tag" model="ir.actions.act_window">
        <field name="name">Asset Code</field>
        <field name="res_model">c18.fixed.asset.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
