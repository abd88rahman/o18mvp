<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_c18_basic_erp" model="ir.ui.view">
        <field name="name">res.company.form.inherit.c18.basic.erp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="before">
                <page string="ERP Settings" name="c18_settings">
                    <group string="Inventory">
                        <field name="inventory_system"/>
                        <field name="costing_method" invisible="inventory_system == 'periodic'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- View khusus (mode="primary" - tidak mempengaruhi base.view_company_list/form
         di tempat lain, mis. Settings > Companies) utk menu "Company Settings":
         single-company tier Basic, admin cuma boleh edit data perusahaan yang sudah
         ada, bukan bikin company baru. -->
    <record id="view_c18_company_list_no_create" model="ir.ui.view">
        <field name="name">res.company.list.c18.no.create</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_c18_company_form_no_create" model="ir.ui.view">
        <field name="name">res.company.form.c18.no.create</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_c18_basic_erp_company_settings" model="ir.actions.act_window">
        <field name="name">Company Settings</field>
        <field name="res_model">res.company</field>
        <field name="res_id" ref="base.main_company"/>
        <field name="view_mode">form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_c18_company_form_no_create')})]"/>
    </record>
</odoo>
