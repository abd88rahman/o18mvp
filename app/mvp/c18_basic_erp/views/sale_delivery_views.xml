<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_sale_delivery_list" model="ir.ui.view">
        <field name="name">c18.sale.delivery.list</field>
        <field name="model">c18.sale.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="so_ref_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_sale_delivery_form" model="ir.ui.view">
        <field name="name">c18.sale.delivery.form</field>
        <field name="model">c18.sale.delivery</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="so_ref_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty_delivered"/>
                            <field name="cost_amount" readonly="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total" string="Total HPP"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_sale_delivery" model="ir.actions.act_window">
        <field name="name">Pengiriman Barang</field>
        <field name="res_model">c18.sale.delivery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
