<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_basic_erp_exchange_rate_list" model="ir.ui.view">
        <field name="name">c18.account.exchange.rate.list</field>
        <field name="model">c18.account.exchange.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate"/>
            </list>
        </field>
    </record>

    <record id="action_c18_basic_erp_exchange_rate" model="ir.actions.act_window">
        <field name="name">Kurs Harian</field>
        <field name="res_model">c18.account.exchange.rate</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
