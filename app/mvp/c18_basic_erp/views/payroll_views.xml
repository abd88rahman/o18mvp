<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c18_payroll_accrual_list" model="ir.ui.view">
        <field name="name">c18.payroll.accrual.list</field>
        <field name="model">c18.payroll.accrual</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="amount_residual"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_payroll_accrual_form" model="ir.ui.view">
        <field name="name">c18.payroll.accrual.form</field>
        <field name="model">c18.payroll.accrual</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pay" type="object" string="Bayar" invisible="state != 'posted' or amount_residual == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                            <field name="note" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_payroll_accrual" model="ir.actions.act_window">
        <field name="name">Jurnal Pengakuan (Hutang Gaji)</field>
        <field name="res_model">c18.payroll.accrual</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_c18_payroll_payment_list" model="ir.ui.view">
        <field name="name">c18.payroll.payment.list</field>
        <field name="model">c18.payroll.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_c18_payroll_payment_form" model="ir.ui.view">
        <field name="name">c18.payroll.payment.form</field>
        <field name="model">c18.payroll.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="state != 'draft'"/>
                            <field name="cost_center_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="accrual_id"/>
                            <field name="amount_original"/>
                            <field name="amount_residual"/>
                            <field name="amount_paid"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_c18_payroll_payment" model="ir.actions.act_window">
        <field name="name">Jurnal Pembayaran (Bayar Gaji)</field>
        <field name="res_model">c18.payroll.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
